DISCORD_TOKEN=replace-with-discord-bot-token
WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
DATABASE_PATH=zodiac.db

# Required for Twitch notifications
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_SECONDS=60

# Required for Spotify song and playlist links
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# FFmpeg must be installed on the host and available on PATH
FFMPEG_PATH=ffmpeg
