DISCORD_TOKEN=replace-with-discord-bot-token
WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
DATABASE_PATH=zodiac.db

# Required for Twitch notifications
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_SECONDS=60

# Required for Spotify song and playlist links
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional user authorization for playlists requiring owner/collaborator access
SPOTIFY_REFRESH_TOKEN=

# Optional Netscape-format YouTube cookie file, outside the repository
YTDLP_COOKIES_FILE=
# Empty enables Deno/Node discovery. Example: node:/usr/bin/node (Node 22+)
YTDLP_JS_RUNTIME=

# FFmpeg must be installed on the host and available on PATH
FFMPEG_PATH=ffmpeg
